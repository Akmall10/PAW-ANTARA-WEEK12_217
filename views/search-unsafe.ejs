<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>⚠️ Demo Rentan - Cari Produk</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-red-50 min-h-screen">
  <div class="bg-red-600 text-white text-center text-sm font-semibold py-2 px-4">
    ⚠️ HALAMAN INI SENGAJA DIBIKIN RENTAN buat demo materi SQL Injection & XSS. JANGAN dipake di production.
  </div>

  <header class="bg-white border-b border-red-200 py-4 px-6 mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-gray-800">Cari Produk (versi rentan)</h1>
      <p class="text-sm text-gray-500">Halo, <%= username %> 👋 — <a href="/search" class="text-blue-600 underline">balik ke versi aman</a></p>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-4">
    <form method="GET" action="/search-unsafe-demo" class="flex gap-2 mb-2">
      <input
        type="text"
        name="q"
        value="<%= query %>"
        placeholder="Coba: ' OR '1'='1  atau  <script>alert(1)</script>"
        class="flex-1 border border-red-300 rounded-lg px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-red-400"
      />
      <button class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg text-sm font-semibold">
        Cari (rentan)
      </button>
    </form>

    <p class="text-xs text-gray-400 mb-6">
      Payload contoh ada di <code>controllers/search.unsafe.controller.js</code>
    </p>

    <% if (sqlError) { %>
      <div class="bg-yellow-50 border border-yellow-300 text-yellow-800 text-sm rounded-lg px-3 py-2 mb-4">
        <strong>Query SQL error</strong> (ini juga tanda endpoint rentan): <%= sqlError %>
      </div>
    <% } %>

    <% if (searched) { %>
      <!--
        ⚠️ SENGAJA pake <%- %> (unescaped) di sini, BUKAN <%= %>.
        Ini yang bikin XSS beneran kejadian: kalo user ketik
        <script>alert(1)</script>, browser bakal beneran ngejalanin
        script itu, bukan nampilin sebagai teks.
      -->
      <p class="text-sm text-gray-500 mb-4">
        Hasil pencarian untuk: <span class="font-medium text-gray-700"><%- query %></span>
        (<%= products.length %> produk)
      </p>
    <% } %>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <% products.forEach(function(product) { %>
        <div class="bg-white border border-red-200 rounded-xl p-4 shadow-sm">
          <!-- ⚠️ sengaja <%- %> juga di sini - demo STORED XSS dari data produk -->
          <h3 class="font-semibold text-gray-800 mb-2"><%- product.name %></h3>
          <p class="text-sm text-gray-500 mb-3"><%- product.description || 'Tanpa deskripsi' %></p>
          <div class="flex items-center justify-between">
            <span class="text-blue-600 font-bold">Rp<%= Number(product.price).toLocaleString('id-ID') %></span>
            <span class="text-xs text-gray-400">Stok: <%= product.stock %></span>
          </div>
        </div>
      <% }) %>
    </div>
  </main>
</body>
</html>
