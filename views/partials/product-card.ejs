<%
const isAvailable = product.stock > 0;
const badgeLabel = isAvailable ? 'Tersedia' : 'Habis';
const badgeColor = isAvailable ? 'green' : 'red';
%>
<div class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm">
  <div class="flex items-start justify-between mb-2">
    <!--
      PENTING: pake <%= %> (bukan <%- %>) di sini. EJS otomatis
      nge-escape karakter HTML-sensitif (<, >, &, ", ') jadi entity aman
      kayak &lt; &gt; dst, jadi walau product.name isinya <script>...</script>,
      yang tampil di browser ya TEKS "<script>..." biasa, gak keeksekusi.
    -->
    <h3 class="font-semibold text-gray-800"><%= product.name %></h3>
    <%- include('badge', { label: badgeLabel, color: badgeColor }) %>
  </div>
  <p class="text-sm text-gray-500 mb-3"><%= product.description || 'Tanpa deskripsi' %></p>
  <div class="flex items-center justify-between">
    <span class="text-blue-600 font-bold">Rp<%= product.price.toLocaleString('id-ID') %></span>
    <span class="text-xs text-gray-400">Stok: <%= product.stock %></span>
  </div>
</div>
