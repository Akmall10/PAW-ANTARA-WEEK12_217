<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Demo Validasi Server-Side</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('../partials/demo-nav', { title: '1. Validasi Input Server-Side' }) %>

  <main class="max-w-xl mx-auto px-4 pb-10">
    <div class="bg-blue-50 border border-blue-200 text-blue-800 text-sm rounded-lg px-4 py-3 mb-6">
      Form ini pake aturan yang SAMA kayak <code>/register</code> beneran
      (<code>registerValidationRules</code> di <code>middlewares/validators.js</code>).
      Coba kosongin field, isi username pake simbol, atau password pendek — semua
      DIVALIDASI DI SERVER, bukan cuma dicek di JS browser.
      Coba juga matiin JavaScript browser lu (atau submit lewat Postman), validasi
      tetep jalan karena emang bukan tanggung jawab client.
    </div>

    <% if (errors.length > 0) { %>
      <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg px-4 py-3 mb-4">
        <strong>Ditolak server:</strong>
        <ul class="list-disc list-inside mt-1">
          <% errors.forEach(function(err) { %>
            <li><%= err %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <% if (result) { %>
      <div class="bg-green-50 border border-green-200 text-green-700 text-sm rounded-lg px-4 py-3 mb-4">
        <strong>Lolos validasi ✅</strong> — data yang diterima server (setelah sanitasi juga ikut jalan):
        <pre class="bg-white/60 rounded p-2 mt-2 text-xs overflow-x-auto"><%= JSON.stringify(result, null, 2) %></pre>
      </div>
    <% } %>

    <form method="POST" action="/demo/validasi-server-side" class="bg-white border border-gray-200 rounded-xl p-5 space-y-3">
      <div>
        <label class="text-sm text-gray-600 block mb-1">Username (3-20 karakter, huruf/angka doang)</label>
        <input type="text" name="username" value="<%= old.username || '' %>" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" />
      </div>
      <div>
        <label class="text-sm text-gray-600 block mb-1">Email</label>
        <input type="text" name="email" value="<%= old.email || '' %>" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" />
      </div>
      <div>
        <label class="text-sm text-gray-600 block mb-1">Password (min 8 karakter, ada angka)</label>
        <input type="text" name="password" value="<%= old.password || '' %>" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" />
      </div>
      <button class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 rounded-lg text-sm">
        Submit ke server
      </button>
    </form>

    <p class="text-xs text-gray-400 mt-4">
      Aturan lengkap ada di <code>middlewares/validators.js</code> →
      <code>registerValidationRules</code>, dipasang di
      <code>routes/demo.routes.js</code>.
    </p>
  </main>
</body>
</html>
